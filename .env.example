# Example only. Set process environment variables before starting services.
# PowerShell helpers for an isolated local database: scripts/dev.ps1
DB_URL=jdbc:mysql://127.0.0.1:3306/tcm_learning?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=123456
# At least 32 random characters. Never use this file to store real secrets in Git.
JWT_SECRET=
AI_INTERNAL_TOKEN=
AI_MODEL_API_KEY=
AI_MODEL_NAME=deepseek-chat
AI_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# false is only for local HTTP. Production requires HTTPS and true.
COOKIE_SECURE=false
SERVER_PORT=8080
